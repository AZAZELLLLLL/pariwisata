# Flask
FLASK_ENV=development
SECRET_KEY=change-this-secret-key

# Database lokal untuk development (XAMPP / MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pariwisataDb
DB_SSL_MODE=disable
# Untuk production yang direkomendasikan project ini: Vercel + TiDB Cloud Starter
# isi salah satu set env di bawah. Kalau TIDB_* diisi di Vercel, app akan membacanya otomatis.
# Opsional untuk database cloud seperti TiDB Cloud / Aiven MySQL
# DB_SSL_ENABLED=true
# DB_SSL_VERIFY_CERT=true
# DB_SSL_VERIFY_IDENTITY=false
# DB_SSL_CA=/absolute/path/to/ca.pem
# Atau simpan isi sertifikat langsung sebagai satu env:
# DB_SSL_CA_CONTENT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Alias opsional khusus TiDB Cloud Starter
# TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=xxxxxxxx.root
# TIDB_PASSWORD=xxxxxxxx
# TIDB_DATABASE=pariwisataDb
# TIDB_SSL_ENABLED=true
# TIDB_SSL_VERIFY_CERT=true
# TIDB_SSL_VERIFY_IDENTITY=true

# Gmail SMTP for OTP email
# Pakai Gmail pengirim + Google App Password 16 digit
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youremail@gmail.com
SMTP_PASSWORD=your-16-digit-app-password
SMTP_FROM_EMAIL=youremail@gmail.com
SMTP_FROM_NAME=EL Travel
SMTP_USE_SSL=false

# Alias opsional jika ingin pakai nama variabel khusus Gmail
# GMAIL_SENDER_EMAIL=youremail@gmail.com
# GMAIL_APP_PASSWORD=your-16-digit-app-password

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Midtrans payment gateway
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Optional fallback manual QRIS image
COMPANY_QRIS_IMAGE_URL=
